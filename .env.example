# Copy this file to .env. Only the publishable key is sent to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional until photos are enabled. Server-only sb_secret_ key; never use VITE_ or commit it.
SUPABASE_STORAGE_SECRET=
# Required on Render. Use the generated dashboard value with username preview.
# Keep this unset for ordinary local development.
PREVIEW_ACCESS_PASSWORD=
# Payments (Stripe Connect). Use TEST keys: sk_test_... and the whsec_... signing secret of the
# webhook endpoint pointing at <APP_ORIGIN>/api/stripe/webhook. Requires SUPABASE_STORAGE_SECRET.
# Buying also stays closed until checkout_enabled is switched on in the database.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the second destination (scope: Connected accounts, event: account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Only for the real launch, with live keys:
# ALLOW_LIVE_PAYMENTS=true
PORT=3000
# Keep localhost while developing. Set the public HTTPS origin before deployment.
APP_ORIGIN=http://localhost:3000
# Leave this unset locally. Render defaults to one trusted reverse-proxy hop.
# TRUST_PROXY_HOPS=0
